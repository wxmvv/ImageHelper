{
  "name": "imagehelper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bulk image extractor and downloader for Chrome and Safari",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "e2e": "node tools/e2e/sniff.test.mjs && node tools/e2e/extractor.test.mjs && node tools/e2e/pages.test.mjs && node tools/e2e/shadow.test.mjs",
    "fixtures": "node tools/e2e/serve-fixtures.mjs",
    "ui:shots": "node tools/ui-shots.mjs",
    "chrome:setup": "node tools/chrome-setup.mjs",
    "safari:build": "node tools/safari-build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^23.11.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
