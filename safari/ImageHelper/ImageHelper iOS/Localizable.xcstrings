{
  "sourceLanguage": "en",
  "strings": {
    "setup.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find and save images from the web in Safari."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Safari 中提取并保存网页图片。"
          }
        }
      }
    },
    "setup.heading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up in Safari"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Safari 中设置"
          }
        }
      }
    },
    "setup.enable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable the extension"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用扩展"
          }
        }
      }
    },
    "setup.settings.modern": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings, go to Apps → Safari → Extensions → ImageHelper and turn on Allow Extension."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开「设置」→「App」→「Safari 浏览器」→「扩展」→「ImageHelper」，打开「允许扩展」。"
          }
        }
      }
    },
    "setup.settings.legacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings, go to Safari → Extensions → ImageHelper and turn on Allow Extension."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开「设置」→「Safari 浏览器」→「扩展」→「ImageHelper」，打开「允许扩展」。"
          }
        }
      }
    },
    "setup.open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a webpage"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开网页"
          }
        }
      }
    },
    "setup.open.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Safari, tap the Page Menu next to the address field and choose ImageHelper. Allow access to the website when prompted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Safari 浏览器中，轻点地址栏旁的页面菜单并选择 ImageHelper。出现提示时允许扩展访问该网站。"
          }
        }
      }
    },
    "setup.extract": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extract and save images"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提取并保存图片"
          }
        }
      }
    },
    "setup.extract.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Extract images from this page. Filter and select images, then save your selection as a ZIP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点「提取本页图片」。筛选并选中图片，然后将所选图片打包保存为 ZIP。"
          }
        }
      }
    },
    "setup.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy policy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私政策"
          }
        }
      }
    }
  },
  "version": "1.0"
}
